  "SignalParameters": {
    "properties": {
      "min_history_observations": {
        "type": "integer",
        "maximum": 365.0,
        "minimum": 3.0,
        "title": "Min History Observations",
        "default": 7
      },
      "min_trend_observations": {
        "type": "integer",
        "maximum": 366.0,
        "minimum": 3.0,
        "title": "Min Trend Observations",
        "default": 7
      },
      "min_price_coverage": {
        "type": "string",
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "title": "Min Price Coverage",
        "description": "Finite Decimal; text input at most 128 characters, fixed representation at most 96 characters; nonzero magnitude at least 1e-64. No rounding or normalization.",
        "default": "0.8"
      },
      "min_index_coverage": {
        "type": "string",
